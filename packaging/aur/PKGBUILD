# Maintainer: Ricardo Molina <molina26ricardo@gmail.com>

pkgname=hyprspanso
pkgver=0.6.2
pkgrel=1
pkgdesc='espanso-compatible trigger/replace text expander for Hyprland/Wayland'
arch=('x86_64' 'aarch64')
url='https://github.com/letoloke/hyprspanso'
license=('MIT')
depends=('wtype' 'wl-clipboard' 'libxkbcommon')
makedepends=('cargo' 'rust' 'pkgconf')
install="$pkgname.install"
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('759ecda1ab148de08262b05819bf056db7b5914521f20ee72397e2da7d93f47c')

build() {
  cd "$pkgname-$pkgver"
  export CARGO_HOME="$srcdir/cargo-home"
  cargo build --release --locked
}

check() {
  cd "$pkgname-$pkgver"
  export CARGO_HOME="$srcdir/cargo-home"
  cargo test --release --locked
}

package() {
  cd "$pkgname-$pkgver"

  install -Dm755 "target/release/$pkgname" "$pkgdir/usr/bin/$pkgname"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"

  # The source unit points at ~/.local/bin (used by install.sh); system
  # installs use /usr/bin.
  install -d "$pkgdir/usr/lib/systemd/user"
  sed 's|%h/.local/bin/hyprspanso|/usr/bin/hyprspanso|' contrib/hyprspanso.service \
    > "$pkgdir/usr/lib/systemd/user/$pkgname.service"
  chmod 644 "$pkgdir/usr/lib/systemd/user/$pkgname.service"
}
